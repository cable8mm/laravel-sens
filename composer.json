{
    "name": "cable8mm/laravel-sens",
    "description": "NCloud SENS notification channels for Lovely Laravel.",
    "keywords": [
        "laravel",
        "laravel-sms",
        "ncloud",
        "sens"
    ],
    "license": "MIT",
    "homepage": "https://open.kakao.com/o/g3dWlf0",
    "support": {
        "issues": "https://github.com/cable8mm/laravel-sens/issues",
        "source": "https://github.com/cable8mm/laravel-sens"
    },
    "authors": [
        {
            "name": "Seungmun Jeong",
            "email": "seungmunj@gmail.com"
        },
        {
            "name": "Samgu Lee",
            "email": "cable8mm@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^6.0|^7.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/notifications": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.29",
        "mockery/mockery": "^1.0",
        "phpunit/phpunit": "^10.0|^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Seungmun\\Sens\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Seungmun\\Sens\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "./vendor/bin/phpunit tests"
        ],
        "lint": [
            "./vendor/bin/pint"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Seungmun\\Sens\\SensServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
